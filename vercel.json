{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "true",
  "outputDirectory": "site",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://cdn.jsdelivr.net; font-src https://cdn.jsdelivr.net; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download/setup",
      "destination": "https://github.com/dawith-ai/dawith-welfare-office/releases/download/v1.0.5/Dawith-Welfare-Office-1.0.5-x64-Setup.exe",
      "permanent": false
    },
    {
      "source": "/download/portable",
      "destination": "https://github.com/dawith-ai/dawith-welfare-office/releases/download/v1.0.5/Dawith-Welfare-Office-1.0.5-x64-Portable.exe",
      "permanent": false
    },
    {
      "source": "/download/mac",
      "destination": "https://github.com/dawith-ai/dawith-welfare-office/releases/download/v1.0.4/Dawith.Welfare.Office-1.0.4-arm64.dmg",
      "permanent": false
    },
    {
      "source": "/download/:file",
      "destination": "https://github.com/dawith-ai/dawith-welfare-office/releases/latest/download/:file",
      "permanent": false
    }
  ]
}
