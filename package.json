{
  "name": "dawith-welfare-office",
  "version": "0.9.8",
  "private": true,
  "type": "module",
  "description": "Dawith lightweight local welfare work tools for files, images, text, dates, and amounts",
  "author": "Dawith",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "check": "node --check server.mjs && node --check src/processing.mjs && node --check src/storage.mjs && node --check src/capabilities.mjs && node --check src/documents.mjs && node --check src/document-export.mjs && node --check src/template-engine.mjs && node --check src/transcription.mjs && node --check src/subscription.mjs && node --check src/ai-connections.mjs && node --check public/app.js && node --check public/toolbox.js && node --check desktop/main.mjs",
    "test:e2e": "playwright test",
    "rea:audit": "node scripts/rea-audit.mjs",
    "desktop": "electron desktop/main.mjs",
    "dist:win": "node scripts/build-lite.mjs",
    "dist:win:setup": "electron-builder --win nsis --x64 --config.compression=maximum --publish never",
    "dist:win:portable": "electron-builder --win portable --x64 --config.compression=maximum --publish never",
    "dist:win:lite": "electron-builder --win portable --x64 --config.compression=maximum --config.directories.output=dist-lite --publish never",
    "dist:dir": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never",
    "dist:win:electron": "npm run dist:win:setup && npm run dist:win:portable",
    "release": "node scripts/release.mjs"
  },
  "main": "desktop/main.mjs",
  "dependencies": {
    "docx": "^9.15.2",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "pdf-lib": "^1.17.1"
  },
  "build": {
    "appId": "site.welfarehub.dawith.welfareoffice",
    "productName": "Dawith Welfare Office",
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "desktop/main.mjs",
      "desktop/updater.mjs",
      "desktop/version.mjs",
      "server.mjs",
      "src/**/*.mjs",
      "public/index.html",
      "public/guide.html",
      "public/styles-tools.css",
      "public/styles-guide.css",
      "public/toolbox.js",
      "public/heartbeat.js",
      "public/manifest.webmanifest",
      "public/sw.js",
      "public/favicon.svg",
      "public/dawith-ci.svg",
      "public/vendor/pdf-lib.min.js",
      "public/vendor/rhwp/rhwp.js",
      "public/vendor/rhwp/rhwp_bg.wasm",
      "public/vendor/rhwp/LICENSE",
      "public/vendor/rhwp/THIRD_PARTY_LICENSES.md",
      "public/vendor/rhwp/NOTICE.md",
      "package.json",
      "!node_modules/docx/dist/*.{cjs,d.ts,d.cts}",
      "!node_modules/docx/dist/*.iife.js",
      "!node_modules/jszip/dist/**",
      "!node_modules/pako/dist/**"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "build/after-pack.mjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Dawith-Welfare-Office-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dawith Welfare Office",
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "Dawith-Welfare-Office-${version}-${arch}-Portable.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/dawith-ai/dawith-welfare-office/releases/latest/download/"
    }
  },
  "license": "Apache-2.0"
}
