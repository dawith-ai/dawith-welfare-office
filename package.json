{
  "name": "dawith-welfare-office",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Dawith local-first welfare record workspace with no cloud LLM path",
  "author": "Dawith",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "check": "node --check server.mjs && node --check src/processing.mjs && node --check src/storage.mjs && node --check src/capabilities.mjs && node --check src/documents.mjs && node --check src/document-export.mjs && node --check src/template-engine.mjs && node --check src/transcription.mjs && node --check public/app.js && node --check desktop/main.mjs",
    "test:e2e": "playwright test",
    "desktop": "electron desktop/main.mjs",
    "dist:win": "npm run dist:win:setup && npm run dist:win:portable",
    "dist:win:setup": "electron-builder --win nsis --x64 --publish never",
    "dist:win:portable": "electron-builder --win portable --x64 --config.compression=store --publish never",
    "dist:dir": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never"
  },
  "main": "desktop/main.mjs",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "site.welfarehub.dawith.welfareoffice",
    "productName": "Dawith Welfare Office",
    "asar": true,
    "files": [
      "desktop/**/*",
      "public/**/*",
      "src/**/*",
      "server.mjs",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Dawith-Welfare-Office-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dawith Welfare Office"
    },
    "portable": {
      "artifactName": "Dawith-Welfare-Office-${version}-${arch}-Portable.${ext}"
    }
  },
  "dependencies": {
    "docx": "^9.14.0",
    "jszip": "^3.10.1"
  }
}
